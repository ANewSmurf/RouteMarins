{
   "manifest_version": 3,
   "name": "RouteMarins",
   "version": "2.0.5",
   "description": "Extract data from Zezo and display them in table ; Direct Windy and Toxcct access ; wind rotation calc ; kml & prog export",
   "minimum_chrome_version": "102",
   "background": {
      "service_worker": "eventPage.js"
   },
   "action": {
      "default_icon": "iconfinder.png",
      "default_popup": "popup.html"
   },
   "content_scripts": [ {
      "js": [ "myscript.js" ],
      "matches": [
         "http://*.zezo.org/*/chart.pl*",
         "https://*.zezo.org/*/chart.pl*"
      ]
   } ],
   "icons": {
      "128": "iconfinder128.png",
      "16": "iconfinder16.png",
      "48": "iconfinder48.png"
   },
   "permissions": [ "tabs", "storage", "downloads" ]
}
